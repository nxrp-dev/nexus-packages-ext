dialect "nxpackage.Language.nxscript";

RepositoryIndex NexusExternalPackages {
    // Discovery only; no traversal or acquisition is implied.
    TrustedRepository NexusOwned {
        Source: "https://github.com/nxrp-dev/nexus-packages.git";
    }

    // Descriptor paths are relative to this repository catalog.
    LocalPackage Abbrevia {
        Id: "NXRP.Compression.Abbrevia";
        Descriptor: "compression/abbrevia/Package.nxscript";
        Description: "Archive and compression runtime units (Abbrevia).";
    }
    LocalPackage PasZLib {
        Id: "NXRP.Compression.PasZLib";
        Descriptor: "compression/paszlib/Package.nxscript";
        Description: "Pascal DEFLATE, zlib, GZIP and ZIP runtime units.";
    }
    LocalPackage Mustache {
        Id: "NXRP.Mustache";
        Descriptor: "mustache/Package.nxscript";
        Description: "Mustache template parsing and rendering (DMustache).";
    }
    LocalPackage RegExpr {
        Id: "NXRP.RegExpr";
        Descriptor: "regexpr/Package.nxscript";
        Description: "Pure Object Pascal regular expression engine (TRegExpr).";
    }
}

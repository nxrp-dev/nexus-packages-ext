package AbbreviaD;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE RELEASE}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'TurboPack Abbrevia Runtime Delphi package'}
{$LIBSUFFIX '270'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl;

contains
  Abbrevia.Archive.Types in '..\..\..\source\Abbrevia.Archive.Types.pas',
  Abbrevia.Base in '..\..\..\source\Abbrevia.Base.pas',
  Abbrevia.BitBucket in '..\..\..\source\Abbrevia.BitBucket.pas',
  Abbrevia.Browser in '..\..\..\source\Abbrevia.Browser.pas',
  Abbrevia.BZip2 in '..\..\..\source\Abbrevia.BZip2.pas',
  Abbrevia.BZip2.Types in '..\..\..\source\Abbrevia.BZip2.Types.pas',
  Abbrevia.Cabinet.Extractor in '..\..\..\source\Abbrevia.Cabinet.Extractor.pas',
  Abbrevia.Cabinet.Kit in '..\..\..\source\Abbrevia.Cabinet.Kit.pas',
  Abbrevia.Cabinet.Builder in '..\..\..\source\Abbrevia.Cabinet.Builder.pas',
  Abbrevia.Cabinet.Types in '..\..\..\source\Abbrevia.Cabinet.Types.pas',
  Abbrevia.Cabinet.Browser in '..\..\..\source\Abbrevia.Cabinet.Browser.pas',
  Abbrevia.Charset in '..\..\..\source\Abbrevia.Charset.pas',
  Abbrevia.Constants in '..\..\..\source\Abbrevia.Constants.pas',
  Abbrevia.CRuntime in '..\..\..\source\Abbrevia.CRuntime.pas',
  Abbrevia.Deflate.Base in '..\..\..\source\Abbrevia.Deflate.Base.pas',
  Abbrevia.Deflate.CryptoStream in '..\..\..\source\Abbrevia.Deflate.CryptoStream.pas',
  Abbrevia.Deflate.Decoder in '..\..\..\source\Abbrevia.Deflate.Decoder.pas',
  Abbrevia.Deflate.Encoder in '..\..\..\source\Abbrevia.Deflate.Encoder.pas',
  Abbrevia.Deflate.HuffmanDecoder in '..\..\..\source\Abbrevia.Deflate.HuffmanDecoder.pas',
  Abbrevia.Deflate.InputWindow in '..\..\..\source\Abbrevia.Deflate.InputWindow.pas',
  Abbrevia.Deflate.OutputWindow in '..\..\..\source\Abbrevia.Deflate.OutputWindow.pas',
  Abbrevia.Deflate.PackageMerge in '..\..\..\source\Abbrevia.Deflate.PackageMerge.pas',
  Abbrevia.Deflate.Stream in '..\..\..\source\Abbrevia.Deflate.Stream.pas',
  Abbrevia.Deflate.Translation in '..\..\..\source\Abbrevia.Deflate.Translation.pas',
  Abbrevia.Exceptions in '..\..\..\source\Abbrevia.Exceptions.pas',
  Abbrevia.Cabinet.API in '..\..\..\source\Abbrevia.Cabinet.API.pas',
  Abbrevia.GZip.Types in '..\..\..\source\Abbrevia.GZip.Types.pas',
  Abbrevia.LZMA in '..\..\..\source\Abbrevia.LZMA.pas',
  Abbrevia.PPMd in '..\..\..\source\Abbrevia.PPMd.pas',
  Abbrevia.ResourceStrings in '..\..\..\source\Abbrevia.ResourceStrings.pas',
  Abbrevia.SelfExtractor in '..\..\..\source\Abbrevia.SelfExtractor.pas',
  Abbrevia.SpanningStream in '..\..\..\source\Abbrevia.SpanningStream.pas',
  Abbrevia.SlidingWindowStream in '..\..\..\source\Abbrevia.SlidingWindowStream.pas',
  Abbrevia.Tar.Types in '..\..\..\source\Abbrevia.Tar.Types.pas',
  Abbrevia.Unzip.OutputStream in '..\..\..\source\Abbrevia.Unzip.OutputStream.pas',
  Abbrevia.Unzipper in '..\..\..\source\Abbrevia.Unzipper.pas',
  Abbrevia.Unzip.Procedures in '..\..\..\source\Abbrevia.Unzip.Procedures.pas',

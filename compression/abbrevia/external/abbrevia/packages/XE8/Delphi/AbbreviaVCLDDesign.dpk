package AbbreviaVCLDDesign;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE RELEASE}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'TurboPack Abbrevia VCL Designtime Delphi package'}
{$LIBSUFFIX '220'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

requires
  designide,
  AbbreviaVCLD;

contains
  Abbrevia.Editors.Collection in '..\..\..\source\Abbrevia.Editors.Collection.pas',
  Abbrevia.Dialogs.Directory in '..\..\..\source\Abbrevia.Dialogs.Directory.pas' {DirDlg},
  Abbrevia.VCL.Editors.FileName in '..\..\..\source\Abbrevia.VCL.Editors.FileName.pas',
  Abbrevia.VCL.Registration in '..\..\..\source\Abbrevia.VCL.Registration.pas',
  Abbrevia.VCL.Editors.Directory in '..\..\..\source\Abbrevia.VCL.Editors.Directory.pas',
  Abbrevia.VCL.Editors.Version in '..\..\..\source\Abbrevia.VCL.Editors.Version.pas' {AbAboutBox},
  Abbrevia.VCL.Dialogs.Password in '..\..\..\source\Abbrevia.VCL.Dialogs.Password.pas' {PassWordDlg},
  Abbrevia.VCL.Editors.Password in '..\..\..\source\Abbrevia.VCL.Editors.Password.pas';

end.

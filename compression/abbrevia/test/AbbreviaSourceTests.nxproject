dialect "../../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module "../../../../../projects/nxbuild/nxbuild.environment.nxscript";
module Projects "../../../../../projects/nxbuild/Projects.nxscript";

Project AbbreviaSourceTests {
    Id: "NXRP.Compression.Abbrevia.SourceTests";
    Requires: [@Projects.NexusRTL, @Projects.RTLObjPas, @Projects.RTLGenerics, @Projects.Abbrevia, @Projects.NexusTest];
    RootDirectory: "../../../../..";
    OutputRoot: @Tools.OutputRoot + "/abbrevia-source-tests/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    NXPC Tests {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: ["packages/nexus-packages-ext/compression/abbrevia/test/AbbreviaTests.lpr"];
        OutputPath: @AbbreviaSourceTests.OutputRoot;
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Language Pascal { Mode: Delphi; }
        BuildControl Rebuild { BuildAllModules: Enabled; }
        Debug Checks { LineInfo: Enabled; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
        }
    }
}

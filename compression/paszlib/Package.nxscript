dialect "nxpackage.Language.nxscript";

// Requires matching RTL and FPC hash units; these are not separate catalog packages.
Package PasZLib {
    Id: "NXRP.Compression.PasZLib";
    Author: "Jacques Nomssi Nzali and Free Pascal contributors";
    Description: "Pascal DEFLATE, zlib, GZIP and ZIP runtime units.";
    License: "zlib and LGPL with the Free Pascal linking exception";
}
